{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/vision", "destination": "/oaic-harness-2026/", "permanent": false },
    { "source": "/rules", "destination": "/oaic-harness-2026/rules", "permanent": false },
    { "source": "/bootcamp", "destination": "/oaic-harness-2026/bootcamp", "permanent": false },
    { "source": "/resources", "destination": "/oaic-harness-2026/resources", "permanent": false },
    { "source": "/profile/:id", "destination": "/oaic-harness-2026/profile/:id", "permanent": false },
    { "source": "/admin", "destination": "/oaic-harness-2026/admin", "permanent": false },
    { "source": "/export", "destination": "/oaic-harness-2026/export", "permanent": false },
    { "source": "/submit", "destination": "/oaic-harness-2026/submit", "permanent": false },
    { "source": "/checkin", "destination": "/oaic-harness-2026/checkin", "permanent": false },
    { "source": "/projects", "destination": "/oaic-harness-2026/projects", "permanent": false }
  ],
  "rewrites": [
    { "source": "/oaic-harness-2026", "destination": "https://oaic-harness-2026.vercel.app/" },
    { "source": "/oaic-harness-2026/:path*", "destination": "https://oaic-harness-2026.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
