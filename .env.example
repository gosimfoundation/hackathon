# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (used for auth redirects, QR codes, etc.)
VITE_SITE_URL=https://your-hackathon.example.com

