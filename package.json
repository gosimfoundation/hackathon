{
  "name": "gosim-hackathon-sites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:events": "python3 scripts/prepare-events.py",
    "test:platform": "node --test scripts/platform-routing.test.mjs",
    "test:releases": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "build": "npm run prepare:events && node scripts/build-site.mjs",
    "preview": "node scripts/serve-site.mjs",
    "dev:hub": "npm run dev --prefix hub",
    "dev:agentic-hackathon-paris-2026": "npm run dev --prefix events/agentic-hackathon-paris-2026"
  }
}
